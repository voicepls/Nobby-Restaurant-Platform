# ============================================================
# Nobby Restaurant Platform — .gitignore
# ============================================================

# Environment / secrets
.env
.env.local
.env.*.local
*.env

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
client/.next/
client/out/
client/.vercel/

# NestJS build
server/dist/

# TypeScript
*.tsbuildinfo

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes (local data)
pgdata/
redisdata/
